{
  "name":"premarket-scanner-html",
  "main":"cloud-sync-worker.mjs",
  "compatibility_date":"2026-10-01",
  "workers_dev":true,
  "preview_urls":false,
  "keep_vars":true,
  "observability":{"enabled":false},
  // Aceeasi politica ca wrangler.toml: pastreaza CLOUD_DB configurat in dashboard.
  "unsafe":{"metadata":{"keep_bindings":["d1","plain_text","json","secret_text","secret_key"]}}
}
