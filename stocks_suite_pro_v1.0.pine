ssd_deleteOnSweep   = input.bool(false, "Delete on Sweep", group=grp_ssd_liq)

grp_ssd_veto = "SSD: Veto Filters"
ssd_useVetos        = input.bool(true,  "Enable Veto Filters", group=grp_ssd_veto)
ssd_minConfBuy      = input.int(40,     "Min Confidence (%)", minval=0, maxval=100, group=grp_ssd_veto)
ssd_vetoOnChop      = input.bool(true,  "Block on CHOP regime", group=grp_ssd_veto)
ssd_vetoOnMixed     = input.bool(false, "Block on MIXED metrics", group=grp_ssd_veto)
ssd_vetoOnHeavyLiq  = input.bool(true,  "Block on Heavy Offer/Bid", group=grp_ssd_veto)
ssd_vetoOnHTFmis    = input.bool(false, "Block on HTF mismatch", group=grp_ssd_veto)
ssd_vetoOnRSIextr   = input.bool(true,  "Block on RSI extremes", group=grp_ssd_veto)
ssd_parabolicPen    = input.bool(true,  "Penalty on Parabolic moves", group=grp_ssd_veto)
ssd_parabolicThresh = input.float(60,   "Parabolic threshold (%)", minval=10, maxval=200, step=5, group=grp_ssd_veto)

grp_ssd_trade = "SSD: Trade Plan"
ssd_maxTPdistAtr = input.float(5.0, "Max TP Distance (xATR)", minval=2.0, maxval=20.0, step=0.5, group=grp_ssd_trade)
