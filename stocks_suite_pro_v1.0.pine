// Stocks Suite PRO v1.0 - Consolidated NASDAQ stocks indicator
// Merges: Smart-Trading-Suite v1.6 + Stocks-Scanner v1.2 + Whale-Tracker-Nasdaq v2.0
// Generated 2026-05-11
//
// Mode selector: suite_mode = "Single Symbol Deep" | "Multi-Scanner" | "Whale Focus"
//
// Bug fixes applied vs. source scripts:
//   [FIX-A] Global: use_anti_repaint toggle gates final signals on bar close
//   [FIX-B] Whale-Tracker: close[rsLookback] wrapped with nz() - avoid na propagation on early bars
//   [FIX-C] Stocks-Scanner: anyStrongBuy/anySell folosesc nz() pe valoarea numerica
//          (NU pe series bool - CE10123) pentru a evita na propagation
//   [FIX-D] Smart-Trading-Suite: atr14 in liquidity minEqDist wrapped with nz() - avoid na on early bars
//   [FIX-E] Pine v6 are limita 40 request.security/script. Total inainte: 51 calls (51 > 40 ERROR).
//          Optimizari: (1) SSD htfRegime+WHF HTF combinate in 1 tuple (6->1, -5),
//                      (2) WHF QQQ in tuple (2->1, -1), (3) WHF Daily pivots in tuple (3->1, -2),
//                      (4) SCA HTF eliminat - MTF derivat din scan-TF emaSt (20->0, -20).
//          Total dupa: 23 calls (mult sub 40). MTF column ramane functional dar arata
//          trend-ul pe scan TF (efectiv "self-alignment"). Pentru HTF veritabil pe Weekly,
//          ruleaza indicatorul pe chart-ul Weekly direct.
//
// Notes:
//   - 3 for-loop "by -1" fixes (Smart-Trading-Suite lines 533/537/723) already in source, preserved.
//   - Whale-Tracker's lookahead_on + [1] on Daily pivots is CORRECT canonical anti-repaint (not a bug).

//@version=6
indicator("Stocks Suite PRO v1.0", overlay=true, max_lines_count=500, max_labels_count=500, max_boxes_count=500, max_bars_back=2000)

// ============================================================
//  MODE SELECTOR
// ============================================================
suite_mode = input.string("Single Symbol Deep", "Suite Mode",
    options=["Single Symbol Deep", "Multi-Scanner", "Whale Focus"],
    group="SUITE MODE",
    tooltip="Single Symbol Deep = deep analysis 1 symbol (Regime + Fib + Liquidity + trade plan)\nMulti-Scanner = overview table on 20 NASDAQ stocks\nWhale Focus = whale scoring + RS vs QQQ + divergences + sessions NY")

bool isSSD = suite_mode == "Single Symbol Deep"
bool isSCA = suite_mode == "Multi-Scanner"
bool isWHF = suite_mode == "Whale Focus"

// ============================================================
//  SHARED INPUTS
// ============================================================
grp_shr = "SHARED CORE"
htf_tf            = input.timeframe("D", "HTF Timeframe (shared)", group=grp_shr)
use_session_filter = input.bool(true, "Use session filter (ET)", group=grp_shr)
dash_pos          = input.string("Top Right", "Dashboard Position", options=["Top Left","Top Center","Top Right","Middle Left","Middle Center","Middle Right","Bottom Left","Bottom Center","Bottom Right"], group=grp_shr)
dash_size         = input.string("Small", "Dashboard Size", options=["Tiny","Small","Normal","Large"], group=grp_shr)
cooldown_bars     = input.int(5, "Cooldown (bars)", minval=1, maxval=50, group=grp_shr)
use_anti_repaint  = input.bool(true, "Anti-repaint (wait close confirm)", group=grp_shr, tooltip="FIX-A: gate final signals on barstate.isconfirmed")

// ============================================================
//  SINGLE SYMBOL DEEP INPUTS (ssd_)
// ============================================================
grp_ssd_p = "SSD: Trading Profile"
ssd_profile = input.string("Stocks Intraday (5m-1H)", "Trading Profile",
    options=["Crypto Intraday (5m-30m)", "Crypto Swing (4H-D)", "Crypto Scalp (1m-5m)", "Stocks Intraday (5m-1H)", "Stocks Swing (D-W)", "Custom (manual toggles)"],
    group=grp_ssd_p)

grp_ssd_reg = "SSD: Regime Engine"
